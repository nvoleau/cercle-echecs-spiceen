# Resend API (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email de destination pour le formulaire de contact
CONTACT_EMAIL=contact@cercle-echecs-spiceen.fr

# URL du site (pour OpenGraph, sitemap)
NEXT_PUBLIC_SITE_URL=https://cercle-echecs-spiceen.fr

# Protection de l'interface Keystatic (/keystatic)
# Sans ces variables, l'accès est libre (pratique en dev local)
KEYSTATIC_PASSWORD=choisir-un-mot-de-passe-fort
KEYSTATIC_SECRET=une-chaine-aleatoire-longue-et-unique
